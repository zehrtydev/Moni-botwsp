# Supabase hosted
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key

# Webhook y Evolution API
WHATSAPP_WEBHOOK_SECRET=replace-with-a-long-random-secret
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-a-long-random-api-key
EVOLUTION_INSTANCE_NAME=moni-production
EVOLUTION_DB_PASSWORD=replace-with-a-url-safe-random-password

# Ollama se ejecuta dentro del mismo Compose.
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=qwen3:1.7b
