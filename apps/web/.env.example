NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
WHATSAPP_WEBHOOK_SECRET=replace-with-a-long-random-secret
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_INSTANCE_NAME=moni-local
# IA local sin API key (requiere Ollama instalado y un modelo descargado)
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:1.7b

# Alternativa opcional si más adelante usas OpenAI
# AI_PROVIDER=openai
